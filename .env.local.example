# Base URL of the TripConsole backend API, including its version prefix.
# The backend mounts routes at /api/v1/... (globalPrefix "api" + URI
# versioning "v1") — see backend/src/main.ts.
#
# Copy this file to .env.local and point it at your running backend.
# .env.local is gitignored by Next.js by default — never commit real values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Frontend-only demo/offline mode — see lib/demo-backend.ts.
# When set to exactly "true", every backend request is answered locally by
# lib/demo-backend.ts instead of calling NEXT_PUBLIC_API_BASE_URL above, and
# the login screen gains a clearly-labeled "Continue in Demo Mode" option.
# No live backend, PostgreSQL, or Memurai is required in this mode.
# NEXT_PUBLIC_* vars are inlined at build time: leaving this unset (the
# default) or set to anything other than "true" keeps the app on the real
# backend path unchanged — this must never be "true" in a real deployment.
NEXT_PUBLIC_DEMO_MODE=false
